---
import { pb } from '../../lib/pocketbase';

export const prerender = false;
pb.authStore.loadFromCookie(Astro.request.headers.get('cookie') || '');

if (pb.authStore.isValid && (pb.authStore.isAdmin || pb.authStore.isSuperuser || pb.authStore.record?.email === 'admin@joksan.dev')) {
  return Astro.redirect('/admin/dashboard');
}

// Render fallback logic if not authenticated or not admin, maybe redirect to login instead?
// Based on current setup, maybe they just need to log in via a dedicated /login route
return Astro.redirect('/');
---
