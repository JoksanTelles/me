---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { BlogEditor } from '../../../components/admin/BlogEditor';
import { pb } from '../../../lib/pocketbase';

export const prerender = false;
const { id } = Astro.params;

if (id !== 'new') {
  try { await pb.collection('blog').getOne(id as string); } 
  catch(e) { return Astro.redirect('/admin/blog'); }
}
---
<AdminLayout title={id === 'new' ? 'Nuevo Artículo' : 'Editar Artículo'} activePath="/admin/blog">
  <BlogEditor recordId={id as string} client:load />
</AdminLayout>
