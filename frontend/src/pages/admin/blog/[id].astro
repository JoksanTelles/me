---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminForm from '../../../components/admin/AdminForm.vue';
import { pb } from '../../../lib/pocketbase';

export const prerender = false;
const { id } = Astro.params;

if (id !== 'new') {
  try { await pb.collection('blog').getOne(id as string); } 
  catch(e) { return Astro.redirect('/admin/blog'); }
}
---
<AdminLayout title={id === 'new' ? 'Nuevo Artículo' : 'Editar Artículo'} activePath="/admin/blog">
  <AdminForm collectionId="blog" recordId={id as string} baseRoute="/admin/blog" recordLookupField="id" client:only="vue" />
</AdminLayout>
