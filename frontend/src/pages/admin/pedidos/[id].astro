---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { TicketView } from '../../../components/admin/TicketView';
import { pb } from '../../../lib/pocketbase';

export const prerender = false;
const { id } = Astro.params;

if (id !== 'new') {
  try { await pb.collection('purchases').getOne(id as string); } 
  catch(e) { return Astro.redirect('/admin/pedidos'); }
}
---
<AdminLayout title={id === 'new' ? 'Nuevo Pedido' : 'Ver Pedido'} activePath="/admin/pedidos">
  <TicketView recordId={id as string} client:load />
</AdminLayout>
