---
import '../../styles/global.css';
import { pb } from '../../lib/pocketbase';
import NavbarUserIcon from '../../components/NavbarUserIcon.vue';

pb.authStore.loadFromCookie(Astro.request.headers.get('cookie') || '');
if (!pb.authStore.isValid) return Astro.redirect('/login');

const user = pb.authStore.record;
if (!user) return Astro.redirect('/login');

// Buscar compras reales
const purchases = await pb.collection('purchases').getFullList({ filter: `user_id="${user.id}"`, expand: 'course_id' });
const userProgress = await pb.collection('user_progress').getFullList({ filter: `user_id="${user.id}"` });

// Cargar información adicional por cada curso comprado
const myCourses = await Promise.all(purchases.map(async (purchase) => {
  const course = purchase.expand?.course_id;
  if (!course) return null;
  // Obtener total de lecciones de este curso
  const sections = await pb.collection('course_sections').getFullList({ filter: `course_id="${course.id}"` });
  let totalLessons = 0;
  let completedLessonsInCourse = 0;
  let nextLessonUrl = `/courses/${course.slug}`; // Fallback

  if (sections.length > 0) {
    for (const sec of sections) {
      const lessons = await pb.collection('lessons').getFullList({ filter: `section_id="${sec.id}"` });
      totalLessons += lessons.length;
      for (const l of lessons) {
        if (userProgress.some(p => p.lesson_id === l.id)) {
          completedLessonsInCourse++;
        } else if (nextLessonUrl === `/courses/${course.slug}`) {
          // Guardamos la primera lección no completada como "siguiente lección"
          nextLessonUrl = `/learn/${course.slug}/${l.id}`;
        }
      }
    }
    // Si terminó todo
    if (completedLessonsInCourse === totalLessons && totalLessons > 0) {
      nextLessonUrl = `/completed`;
    }
  }

  const progressPercent = totalLessons === 0 ? 0 : Math.round((completedLessonsInCourse / totalLessons) * 100);

  return {
    ...course,
    progressPercent,
    nextLessonUrl
  };
})).then(results => results.filter(c => c !== null));
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Mi Dashboard | Joksan</title>
</head>
<body class="min-h-screen bg-stone-50 font-sans text-stone-900 antialiased">
  
  <header class="bg-white border-b border-stone-200 py-4 px-8 flex justify-between items-center relative z-20">
    <a href="/" class="font-title text-2xl text-rose-950 uppercase hover:text-rose-600 transition-colors">Joksan</a>
    <div class="flex items-center gap-6">
      <div class="relative cursor-pointer hover:opacity-80 transition-opacity">
        <span class="absolute -top-1 -right-1 w-3 h-3 bg-rose-500 rounded-full border-2 border-white"></span>
        🔔
      </div>
      
      <!-- Componente Vue interactivo para el menú oculto -->
      <NavbarUserIcon client:load userName={user.name} />

    </div>
  </header>

  <main class="max-w-5xl mx-auto py-12 px-4 relative z-10">
    <div class="flex justify-between items-end mb-8">
      <div>
        <p class="text-stone-500 font-medium">Hola, {user.name.split(' ')[0]}</p>
        <h2 class="font-title text-4xl text-stone-800 uppercase mt-1">Mis Cursos</h2>
      </div>
      <a href="/courses" class="text-rose-600 hover:text-rose-700 font-bold uppercase text-sm tracking-wide bg-rose-50 px-4 py-2 rounded-lg">Explorar más</a>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      {myCourses.length === 0 ? (
        <div class="col-span-full text-center py-16 bg-white rounded-3xl border border-stone-200 border-dashed">
          <p class="text-stone-500 mb-4">Aún no has adquirido ningún curso.</p>
          <a href="/courses" class="bg-rose-500 hover:bg-rose-600 text-white font-bold py-3 px-6 rounded-xl transition-all">Ver catálogo</a>
        </div>
      ) : (
        myCourses.map(course => (
          <div class="bg-white rounded-3xl p-6 shadow-sm border border-stone-200 flex flex-col">
            <h3 class="font-title text-xl text-rose-600 uppercase mb-2">{course.title}</h3>
            <p class="text-stone-500 text-sm mb-6 flex-1">{course.description.substring(0, 80)}...</p>
            
            <div class="mb-6">
              <div class="flex justify-between text-xs font-bold text-stone-500 mb-2 uppercase tracking-wide">
                <span>Progreso</span>
                <span>{course.progressPercent}%</span>
              </div>
              <div class="w-full bg-stone-100 rounded-full h-3">
                <div class="bg-rose-500 h-3 rounded-full transition-all duration-1000" style={`width: ${course.progressPercent}%`}></div>
              </div>
            </div>

            <a href={course.nextLessonUrl} class="block w-full text-center bg-rose-100 hover:bg-rose-200 text-rose-700 font-bold py-3 rounded-xl transition-all uppercase text-sm tracking-wide">
              {course.progressPercent === 100 ? 'Ver Certificado / Repasar' : (course.progressPercent === 0 ? 'Iniciar Curso' : 'Continuar Curso')}
            </a>
          </div>
        ))
      )}

    </div>
  </main>
</body>
</html>
