---
import '../styles/global.css';
import { pb } from '../lib/pocketbase';
import UserLayout from '../layouts/UserLayout.astro';

pb.authStore.loadFromCookie(Astro.request.headers.get('cookie') || '');

if (!pb.authStore.isValid) {
  return Astro.redirect('/login');
}

const user = pb.authStore.record;
if (!user) {
  return Astro.redirect('/login');
}

let purchases: any[] = [];
try {
  purchases = await pb.collection('purchases').getFullList({ 
    filter: `user_id="${user.id}"`, 
    expand: 'course_id',
    sort: '-created'
  });
} catch(e) {
  console.error("Error fetching purchases:", e);
}
---

<UserLayout title="Mis Pedidos" user={user}>
  <main class="max-w-4xl mx-auto py-12 px-4 relative z-10 w-full flex-1">
    <div class="mb-8">
      <a href="/" class="text-stone-400 hover:text-rose-600 mb-4 inline-block font-medium text-sm">← Volver al inicio</a>
      <h1 class="font-title text-4xl text-rose-950 uppercase">Mis Pedidos</h1>
      <p class="text-stone-500 mt-2">Historial de tus compras y suscripciones.</p>
    </div>
    
    {purchases.length === 0 ? (
      <div class="bg-white rounded-3xl p-12 shadow-sm border border-stone-200 text-center flex flex-col items-center justify-center">
        <div class="text-6xl mb-4">🛒</div>
        <h2 class="font-title text-2xl text-stone-800 uppercase mb-2">No tienes pedidos</h2>
        <p class="text-stone-500 max-w-md mb-6">Aún no has adquirido ningún curso. Cuando lo hagas, tus recibos aparecerán aquí.</p>
        <a href="/courses" class="bg-rose-500 hover:bg-rose-600 text-white font-bold py-3 px-6 rounded-xl transition-all shadow-md">Ver Catálogo</a>
      </div>
    ) : (
      <div class="bg-white rounded-3xl shadow-sm border border-stone-200 overflow-hidden">
        <table class="w-full text-left">
          <thead class="bg-stone-50 border-b border-stone-100 text-stone-500 text-xs uppercase tracking-wider">
            <tr>
              <th class="px-6 py-4 font-bold">Curso</th>
              <th class="px-6 py-4 font-bold">Fecha</th>
              <th class="px-6 py-4 font-bold">Monto</th>
              <th class="px-6 py-4 font-bold">Estado</th>
              <th class="px-6 py-4 font-bold text-right">Acción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            {purchases.map((purchase: any) => (
              <tr class="hover:bg-stone-50 transition-colors">
                <td class="px-6 py-4">
                  <a href={`/orders/${purchase.id}`} class="block hover:underline">
                    <div class="font-title text-rose-950 uppercase">{purchase.expand?.course_id?.title || 'Curso eliminado'}</div>
                    <div class="text-xs text-stone-400 font-mono mt-1">Ref: {purchase.stripe_payment_intent_id.substring(0, 15)}...</div>
                  </a>
                </td>
                <td class="px-6 py-4 text-stone-600 text-sm">
                  {new Date(purchase.created).toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
                </td>
                <td class="px-6 py-4 font-bold text-stone-800">
                  ${purchase.amount}
                </td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wide bg-green-100 text-green-800">
                    Completado
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <a href={`/orders/${purchase.id}`} class="text-rose-600 font-bold hover:underline text-sm uppercase tracking-wide">
                    Ver Ticket
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </main>
</UserLayout>
