---
import '../../../styles/global.css';
import { pb } from '../../../lib/pocketbase';

pb.authStore.loadFromCookie(Astro.request.headers.get('cookie') || '');
if (!pb.authStore.isValid) return Astro.redirect('/login');

const { course_id, lesson_id } = Astro.params;
if (!course_id || !lesson_id) return Astro.redirect('/dashboard');

const user = pb.authStore.record;
if (!user) return Astro.redirect('/login');

// Validar compra
let course = null;
try {
  course = await pb.collection('courses').getFirstListItem(`slug="${course_id}"`);
  const purchase = await pb.collection('purchases').getFirstListItem(`user_id="${user.id}" && course_id="${course.id}"`);
  
  if (purchase.expires_at) {
    const expires = new Date(purchase.expires_at);
    if (expires < new Date()) {
      // Si ya expiró, lo redirigimos al curso para que pueda ver por qué no tiene acceso.
      return Astro.redirect(`/courses/${course_id}?error=expired`);
    }
  }
} catch(e) {
  return Astro.redirect(`/courses/${course_id}`);
}

// Obtener lección actual
let currentLesson = null;
let currentSection = null;
try {
  currentLesson = await pb.collection('lessons').getOne(lesson_id);
  currentSection = await pb.collection('course_sections').getOne(currentLesson.section_id);
} catch(e) {
  return Astro.redirect('/dashboard');
}

// Obtener todas las secciones y lecciones para el sidebar
const sections = await pb.collection('course_sections').getFullList({ filter: `course_id="${course.id}"`, sort: 'order' });
const allLessons = await pb.collection('lessons').getFullList({ sort: 'order' });
const userProgress = await pb.collection('user_progress').getFullList({ filter: `user_id="${user.id}"` });
const completedLessonIds = userProgress.map(p => p.lesson_id);

// La lógica de evaluaciones independientes se ha eliminado. Los quizzes ahora son bloques interactivos.

if (Astro.request.method === 'POST') {
  // Marcar progreso
  if (!completedLessonIds.includes(currentLesson.id)) {
    await pb.collection('user_progress').create({
      user_id: user.id,
      lesson_id: currentLesson.id,
      isCompleted: true
    });
  }

  // Buscar siguiente lección
  const currentIndex = allLessons.findIndex(l => l.id === currentLesson.id);
  if (currentIndex !== -1 && currentIndex + 1 < allLessons.length) {
    return Astro.redirect(`/learn/${course.slug}/${allLessons[currentIndex + 1].id}`);
  }

  return Astro.redirect('/completed');
}

---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>{currentLesson.title} | {course.title}</title>
</head>
<body class="h-screen bg-stone-50 font-sans text-stone-900 antialiased flex overflow-hidden">
  
  <aside class="w-80 bg-white border-r border-stone-200 flex flex-col h-full">
    <div class="p-6 border-b border-stone-100">
      <a href="/dashboard" class="text-sm font-medium text-stone-500 hover:text-rose-500 mb-2 inline-block">← Dashboard</a>
      <h2 class="font-title text-xl text-rose-950 uppercase">{course.title}</h2>
    </div>
    
    <div class="flex-1 overflow-y-auto p-4 space-y-6">
      <!-- Navigating to projects -->
      <div>
        <a href={`/learn/${course.slug}/projects`} class="flex items-center gap-3 text-sm p-2 rounded-lg transition-colors text-stone-500 hover:bg-stone-100 font-bold">
          <span class="text-stone-300">▶</span> Proyectos del Curso
        </a>
      </div>

      {sections.map(section => {
        const sectionLessons = allLessons.filter(l => l.section_id === section.id);
        return (
          <div>
            <h3 class="font-bold text-stone-800 mb-3 text-sm uppercase tracking-wide">{section.title}</h3>
            <ul class="space-y-2">
              {sectionLessons.map(lesson => {
                const isCurrent = lesson.id === currentLesson.id;
                const isCompleted = completedLessonIds.includes(lesson.id);
                return (
                  <a href={`/learn/${course.slug}/${lesson.id}`} class={`flex items-center gap-3 text-sm p-2 rounded-lg transition-colors ${isCurrent ? 'bg-rose-50 text-rose-600 font-bold' : 'text-stone-500 hover:bg-stone-100'}`}>
                    {isCompleted ? <span class="text-green-500">✓</span> : <span class={isCurrent ? 'text-rose-500' : 'text-stone-300'}>▶</span>}
                    {lesson.title}
                  </a>
                )
              })}
            </ul>
          </div>
        )
      })}
    </div>
  </aside>

  <main class="flex-1 overflow-y-auto p-8 md:p-12 relative">
    <div class="max-w-3xl mx-auto pb-20">
      <h1 class="font-title text-4xl text-stone-900 uppercase mb-6">{currentLesson.title}</h1>
      


      <div class="tiptap-styled-content bg-white p-8 rounded-2xl shadow-sm border border-stone-100" set:html={currentLesson.content?.html || '<p class="text-stone-400 italic">No hay contenido en esta lección.</p>'}>
      </div>
    </div>

    <div class="fixed bottom-0 left-80 right-0 bg-white border-t border-stone-200 p-4 flex justify-between items-center">
      <div class="text-stone-500 font-medium px-4">Progreso guardado automáticamente</div>
      <form method="POST">
        <button type="submit" class="bg-rose-500 hover:bg-rose-600 text-white font-bold py-3 px-8 rounded-xl shadow-md transition-all uppercase text-sm tracking-wide">
          Completar y Continuar
        </button>
      </form>
    </div>
  </main>

  <!-- Highlight.js para los bloques de código -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
  <!-- KaTeX para las matemáticas -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css" />
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/contrib/auto-render.min.js"></script>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Aplicar Highlight.js a los bloques de código
      if (typeof hljs !== 'undefined') {
        document.querySelectorAll('pre code').forEach((block) => {
          hljs.highlightElement(block);
        });
      }
      
      // Aplicar KaTeX para fórmulas matemáticas
      if (typeof renderMathInElement !== 'undefined') {
        renderMathInElement(document.body, {
          delimiters: [
            {left: '$$', right: '$$', display: true},
            {left: '$', right: '$', display: false},
            {left: '\\(', right: '\\)', display: false},
            {left: '\\[', right: '\\]', display: true}
          ],
          throwOnError: false
        });
      }
    });
  </script>
</body>
</html>
