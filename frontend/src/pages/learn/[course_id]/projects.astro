---
import '../../../styles/global.css';
import { pb } from '../../../lib/pocketbase';

pb.authStore.loadFromCookie(Astro.request.headers.get('cookie') || '');
if (!pb.authStore.isValid || !pb.authStore.record) return Astro.redirect('/login');

const { course_id } = Astro.params;
const user = pb.authStore.record;

// Validar compra
let course: any = null;
try {
  course = await pb.collection('courses').getFirstListItem(`slug="${course_id}"`);
  const purchase = await pb.collection('purchases').getFirstListItem(`user_id="${user.id}" && course_id="${course.id}"`);
  if (purchase.expires_at && new Date(purchase.expires_at) < new Date()) {
    return Astro.redirect(`/courses/${course_id}?error=expired`);
  }
} catch(e) {
  return Astro.redirect(`/courses/${course_id}`);
}

const projects = await pb.collection('projects').getFullList({ filter: `course_id="${course.id}"`, sort: 'order' });
const projectIds = projects.map(p => p.id);

// And student submissions
let submissions: any[] = [];
if (projectIds.length > 0) {
  submissions = await pb.collection('student_projects').getFullList({ filter: `user_id="${user.id}" && (${projectIds.map(id => `project_id="${id}"`).join(' || ')})` });
}

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const project_id = data.get('project_id') as string;
  const title = data.get('title') as string;
  const description = data.get('description') as string;
  const link = data.get('link') as string;
  
  // check if exists
  const existing = submissions.find(s => s.project_id === project_id);
  if (existing) {
    await pb.collection('student_projects').update(existing.id, { title, description, link, status: 'submitted' });
  } else {
    await pb.collection('student_projects').create({
      user_id: user.id,
      project_id,
      title,
      description,
      link,
      status: 'submitted'
    });
  }
  return Astro.redirect(`/learn/${course.slug}/projects`);
}

// Sidebar links
const sections = await pb.collection('course_sections').getFullList({ filter: `course_id="${course.id}"`, sort: 'order' });
const allLessons = await pb.collection('lessons').getFullList({ sort: 'order' });
const userProgress = await pb.collection('user_progress').getFullList({ filter: `user_id="${user.id}"` });
const completedLessonIds = userProgress.map(p => p.lesson_id);
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Proyectos | {course.title}</title>
</head>
<body class="h-screen bg-stone-50 font-sans text-stone-900 antialiased flex overflow-hidden">
  
  <aside class="w-80 bg-white border-r border-stone-200 flex flex-col h-full shrink-0">
    <div class="p-6 border-b border-stone-100">
      <a href="/dashboard" class="text-sm font-medium text-stone-500 hover:text-rose-500 mb-2 inline-block">← Dashboard</a>
      <h2 class="font-title text-xl text-rose-950 uppercase">{course.title}</h2>
    </div>
    
    <div class="flex-1 overflow-y-auto p-4 space-y-6">
      
      <!-- Navigating to projects -->
      <div>
        <a href={`/learn/${course.slug}/projects`} class="flex items-center gap-3 text-sm p-2 rounded-lg transition-colors bg-rose-50 text-rose-600 font-bold">
          <span class="text-rose-500">▶</span> Proyectos del Curso
        </a>
      </div>

      {sections.map(section => {
        const sectionLessons = allLessons.filter(l => l.section_id === section.id);
        return (
          <div>
            <h3 class="font-bold text-stone-800 mb-3 text-sm uppercase tracking-wide">{section.title}</h3>
            <ul class="space-y-2">
              {sectionLessons.map(lesson => {
                const isCompleted = completedLessonIds.includes(lesson.id);
                return (
                  <a href={`/learn/${course.slug}/${lesson.id}`} class="flex items-center gap-3 text-sm p-2 rounded-lg transition-colors text-stone-500 hover:bg-stone-100">
                    {isCompleted ? <span class="text-green-500">✓</span> : <span class="text-stone-300">▶</span>}
                    {lesson.title}
                  </a>
                )
              })}
            </ul>
          </div>
        )
      })}
    </div>
  </aside>

  <main class="flex-1 overflow-y-auto p-8 md:p-12 relative">
    <div class="max-w-3xl mx-auto pb-20">
      <h1 class="font-title text-4xl text-stone-900 uppercase mb-8">Proyectos del Curso</h1>
      
      {projects.length === 0 ? (
        <p class="text-stone-500 italic bg-white p-6 rounded-2xl border border-stone-200 text-center shadow-sm">No hay proyectos asignados para este curso aún.</p>
      ) : (
        <div class="space-y-12">
          {projects.map(project => {
            const submission = submissions.find(s => s.project_id === project.id);
            
            return (
              <div class="bg-white rounded-3xl p-8 border border-stone-200 shadow-sm">
                <h2 class="font-title text-2xl text-rose-950 uppercase mb-4">{project.title}</h2>
                <div class="prose prose-stone mb-8 max-w-none">{project.description}</div>

                <div class="bg-rose-50 rounded-2xl p-6 border border-rose-100">
                  <h3 class="font-bold uppercase text-xs tracking-wider text-rose-500 mb-4">Tu Entrega</h3>
                  {submission?.status === 'graded' ? (
                    <div class="text-green-600 font-bold bg-green-50 p-4 rounded-xl border border-green-200">
                      ✅ Tu proyecto ha sido calificado exitosamente.
                    </div>
                  ) : (
                    <form method="POST" class="space-y-4">
                      <input type="hidden" name="project_id" value={project.id} />
                      
                      <div>
                        <label class="block text-xs font-bold text-stone-700 uppercase mb-2">Título de tu trabajo</label>
                        <input type="text" name="title" required value={submission?.title || ''} class="w-full bg-white border border-rose-200 rounded-xl px-4 py-3 outline-none focus:border-rose-400" />
                      </div>
                      
                      <div>
                        <label class="block text-xs font-bold text-stone-700 uppercase mb-2">Descripción o notas (Opcional)</label>
                        <textarea name="description" rows="3" class="w-full bg-white border border-rose-200 rounded-xl px-4 py-3 outline-none focus:border-rose-400">{submission?.description || ''}</textarea>
                      </div>
                      
                      <div>
                        <label class="block text-xs font-bold text-stone-700 uppercase mb-2">Enlace (URL del entregable)</label>
                        <input type="url" name="link" required value={submission?.link || ''} placeholder="https://..." class="w-full bg-white border border-rose-200 rounded-xl px-4 py-3 outline-none focus:border-rose-400" />
                      </div>

                      <button type="submit" class="w-full bg-rose-500 hover:bg-rose-600 text-white font-bold py-3 px-6 rounded-xl transition-colors uppercase text-sm">
                        {submission ? 'Actualizar Entrega' : 'Enviar Proyecto'}
                      </button>
                    </form>
                  )}
                </div>
              </div>
            )
          })}
        </div>
      )}
    </div>
  </main>
</body>
</html>
