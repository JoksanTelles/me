---
import '../styles/global.css';
import { pb } from '../lib/pocketbase';
import Stripe from 'stripe';
import UserLayout from '../layouts/UserLayout.astro';

pb.authStore.loadFromCookie(Astro.request.headers.get('cookie') || '');

if (!pb.authStore.isValid) {
  return Astro.redirect('/login');
}

const user = pb.authStore.record;
if (!user) {
  return Astro.redirect('/login');
}
const paymentIntentId = Astro.url.searchParams.get('payment_intent');
const redirectStatus = Astro.url.searchParams.get('redirect_status');

let errorMsg = '';
let success = false;
let courseId = null;

const isFree = Astro.url.searchParams.get('free');

if (isFree === 'true') {
  success = true;
} else if (paymentIntentId && redirectStatus === 'succeeded') {
  try {
    const stripe = new Stripe(import.meta.env.STRIPE_SECRET_KEY, {
      apiVersion: '2026-05-27.dahlia',
    });
    
    // Verificar con Stripe que el pago realmente fue exitoso (por seguridad)
    const paymentIntent = await stripe.paymentIntents.retrieve(paymentIntentId);
    
    if (paymentIntent.status === 'succeeded') {
      const courseIdsStr = paymentIntent.metadata.course_ids;
      if (courseIdsStr) {
        const courseIds = courseIdsStr.split(',');
        const amount = paymentIntent.amount / 100;
        
        // Limpiar carrito
        Astro.cookies.delete('cart_course_ids', { path: '/' });

        // Authenticate as admin to create purchase securely and avoid API Rule rejections
        const pbAdmin = new (pb.constructor as any)(import.meta.env.PUBLIC_POCKETBASE_URL || 'http://127.0.0.1:8090');
        
        try {
          // JS SDK is v0.27 but backend is v0.22, so we must manually hit the old admin endpoint
          const authData = await pbAdmin.send('/api/admins/auth-with-password', {
            method: 'POST',
            body: { identity: 'admin@joksan.dev', password: '1234567890' }
          });
          pbAdmin.authStore.save(authData.token, authData.admin);
        } catch (e) {
          console.error("Admin auth error:", e);
        }
        
        for (const cId of courseIds) {
          const existing = await pbAdmin.collection('purchases').getList(1, 1, {
            filter: `stripe_payment_intent_id="${paymentIntent.id}" && course_id="${cId}"`
          });

          if (existing.totalItems === 0) {
            const course = await pbAdmin.collection('courses').getOne(cId);
            let expires_at = "";
            if (course.access_days > 0) {
               const date = new Date();
               date.setDate(date.getDate() + course.access_days);
               expires_at = date.toISOString();
            }

            // Distribuir el monto equitativamente o usar 0 si no nos importa el monto individual
            await pbAdmin.collection('purchases').create({
              user_id: user.id,
              course_id: cId,
              amount: amount / courseIds.length,
              status: 'completed',
              stripe_payment_intent_id: paymentIntent.id,
              stripe_session_id: paymentIntent.id + "_" + cId, // unique per course
              expires_at: expires_at
            });
          }
        }
      }
      success = true;
    } else {
      errorMsg = 'El pago no ha sido completado. Estado: ' + paymentIntent.status;
    }
  } catch (e: any) {
    console.error("Success page error:", e);
    errorMsg = 'Error verificando el pago: ' + e.message;
  }
} else if (redirectStatus === 'failed') {
  errorMsg = 'El pago ha fallado. Por favor, intenta de nuevo.';
} else {
  // Sin query params, o status distinto
  errorMsg = 'No se encontró información del pago.';
}
---

<UserLayout title="Estado de Pago" user={user}>
  <div class="flex flex-col items-center justify-center py-12 px-4 text-center w-full min-h-[60vh]">
    <div class="max-w-md w-full bg-white rounded-3xl p-10 shadow-xl border border-stone-100">
      {success ? (
        <>
          <div class="w-20 h-20 bg-green-100 text-green-500 rounded-full flex items-center justify-center mx-auto mb-6 text-4xl">
            ✓
          </div>
          <h1 class="font-title text-3xl text-rose-950 uppercase mb-4">
            {isFree === 'true' ? '¡Ya estás inscrito al curso!' : '¡Pago Exitoso!'}
          </h1>
          <p class="text-stone-600 mb-8 leading-relaxed">
            {isFree === 'true' 
              ? 'Te has inscrito exitosamente. Ya puedes acceder al contenido del curso.' 
              : 'Tu compra se ha procesado correctamente. Ya tienes acceso al curso.'}
          </p>
          <a href="/" class="block w-full text-center bg-stone-900 hover:bg-black text-white font-bold py-4 rounded-xl shadow-md transition-all uppercase tracking-wide">
            Ir a mis cursos
          </a>
        </>
      ) : (
        <>
          <div class="w-20 h-20 bg-red-100 text-red-500 rounded-full flex items-center justify-center mx-auto mb-6 text-4xl">
            ✕
          </div>
          <h1 class="font-title text-3xl text-rose-950 uppercase mb-4">Error en el Pago</h1>
          <p class="text-stone-600 mb-8 leading-relaxed">
            {errorMsg}
          </p>
          <a href="/cart" class="block w-full text-center bg-rose-500 hover:bg-rose-600 text-white font-bold py-4 rounded-xl shadow-md transition-all uppercase tracking-wide">
            Volver al carrito
          </a>
        </>
      )}
    </div>
  </div>
</UserLayout>
