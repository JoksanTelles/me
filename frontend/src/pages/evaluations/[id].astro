---
import '../../styles/global.css';
import { pb } from '../../lib/pocketbase';

pb.authStore.loadFromCookie(Astro.request.headers.get('cookie') || '');
if (!pb.authStore.isValid) return Astro.redirect('/login');

const { id } = Astro.params;
const user = pb.authStore.record;
if (!user) return Astro.redirect('/login');

const courseSlug = Astro.url.searchParams.get('course') || 'diseno-web';

let evaluation = null;
try {
  evaluation = await pb.collection('evaluations').getOne(id as string);
} catch(e) {
  return Astro.redirect('/dashboard');
}

const questions = evaluation.questions || [];
let errorMsg = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  
  let correctCount = 0;
  questions.forEach((q: any, index: number) => {
    const answer = formData.get(`q${index}`) as string | null;
    if (answer !== null && parseInt(answer) === q.correctIndex) {
      correctCount++;
    }
  });

  const score = (correctCount / questions.length) * 100;
  const isPassed = score >= evaluation.passingScore;

  try {
    await pb.collection('user_evaluations').create({
      user_id: user.id,
      evaluation_id: evaluation.id,
      score,
      isPassed
    });

    if (isPassed) {
      // Avanzar a finalización
      return Astro.redirect('/completed');
    } else {
      errorMsg = `Obtuviste ${score}%. Necesitas ${evaluation.passingScore}% para aprobar. ¡Inténtalo de nuevo!`;
    }
  } catch(e) {
    errorMsg = "Error guardando la evaluación.";
  }
}
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Evaluación | Joksan</title>
</head>
<body class="min-h-screen bg-stone-50 font-sans text-stone-900 antialiased flex flex-col items-center py-12 px-4">
  
  <div class="max-w-2xl w-full bg-white rounded-3xl p-10 shadow-lg border border-stone-100">
    <div class="flex justify-between items-center mb-8">
      <h1 class="font-title text-3xl text-rose-950 uppercase">Evaluación</h1>
      <span class="text-sm font-bold text-stone-500 bg-stone-100 px-3 py-1 rounded-full">{questions.length} Preguntas</span>
    </div>

    {errorMsg && <div class="bg-red-100 text-red-700 p-4 rounded-xl mb-6 text-sm font-medium">{errorMsg}</div>}

    <form method="POST">
      {questions.map((q: any, qIndex: number) => (
        <div class="mb-10">
          <p class="text-lg text-stone-800 font-medium mb-6">{q.question}</p>
          <div class="space-y-3">
            {q.options.map((opt: string, optIndex: number) => (
              <label class="flex items-center p-4 border border-stone-200 rounded-xl cursor-pointer hover:bg-rose-50 hover:border-rose-300 transition-colors">
                <input type="radio" name={`q${qIndex}`} value={optIndex} required class="mr-4 accent-rose-500 w-5 h-5" />
                <span>{opt}</span>
              </label>
            ))}
          </div>
        </div>
      ))}

      <div class="flex justify-end border-t border-stone-100 pt-6">
        <button type="submit" class="bg-rose-500 hover:bg-rose-600 text-white font-bold py-3 px-8 rounded-xl shadow-md transition-all uppercase tracking-wide">
          Enviar Respuestas
        </button>
      </div>
    </form>
  </div>
</body>
</html>
