---
import "../../styles/global.css";

export function getStaticPaths() {
  return [
    { params: { id: '123' } }
  ];
}

const { id } = Astro.params;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Certificado | Joksan</title>
    <style>
      @media print {
        .no-print { display: none !important; }
        body { background: white; }
        .shadow-2xl { box-shadow: none !important; }
      }
    </style>
  </head>
  <body
    class="min-h-screen bg-stone-100 font-sans text-stone-900 antialiased flex flex-col items-center py-12 px-4"
  >
    <div class="max-w-4xl w-full flex flex-col items-center">
      <a
        href="/dashboard"
        class="text-stone-500 hover:text-rose-600 mb-8 font-medium self-start no-print"
        >← Volver al Dashboard</a
      >

      <!-- Certificado UI -->
      <div
        class="w-full bg-white rounded-xl shadow-2xl border-8 border-stone-100 p-12 md:p-20 text-center relative overflow-hidden mb-8"
      >
        <!-- Sello / Adorno -->
        <div
          class="absolute top-0 right-0 w-40 h-40 bg-rose-50 rounded-bl-full z-0"
        >
        </div>
        <div
          class="absolute bottom-10 left-10 w-24 h-24 border-4 border-rose-200 rounded-full flex items-center justify-center opacity-50 z-0"
        >
          <span class="text-rose-300 font-title text-2xl">SELLO</span>
        </div>

        <div class="relative z-10">
          <h2
            class="font-title text-xl text-stone-400 tracking-widest uppercase mb-8"
          >
            Certificado de Finalización
          </h2>
          <h1 class="font-title text-5xl text-rose-950 uppercase mb-4">
            Diseño Web Moderno
          </h1>
          <p class="text-stone-500 text-lg mb-12">
            Otorgado a <strong class="text-stone-800"
              >Estudiante Ejemplar</strong
            > por haber completado satisfactoriamente el programa de estudios.
          </p>

          <div
            class="flex justify-between items-end border-t border-stone-200 pt-8 mt-12"
          >
            <div class="text-left">
              <p class="font-title text-lg text-stone-800">Joksan Telles</p>
              <p class="text-stone-400 text-sm">Instructor</p>
            </div>
            <div class="text-right">
              <p class="text-stone-500 font-medium">
                Fecha: <span class="text-stone-800">12 Oct 2026</span>
              </p>
              <p class="text-stone-400 text-xs mt-1">ID: #{id}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Botones de Acción -->
      <div class="flex gap-4 w-full md:w-auto no-print">
        <button
          onclick="window.print()"
          class="flex-1 md:flex-none bg-stone-900 hover:bg-black text-white font-bold py-3 px-8 rounded-xl shadow-md transition-all uppercase tracking-wide text-sm flex items-center justify-center gap-2"
        >
          📥 Descargar PDF
        </button>
        <button
          onclick="navigator.clipboard.writeText(window.location.href); alert('¡Enlace público copiado al portapapeles!');"
          class="flex-1 md:flex-none bg-rose-600 hover:bg-rose-700 text-white font-bold py-3 px-8 rounded-xl shadow-md transition-all uppercase tracking-wide text-sm flex items-center justify-center gap-2"
        >
          🔗 Compartir Enlace
        </button>
      </div>
    </div>
  </body>
</html>
