---
import '../styles/global.css';
import { pb } from '../lib/pocketbase';
import UserLayout from '../layouts/UserLayout.astro';

pb.authStore.loadFromCookie(Astro.request.headers.get('cookie') || '');
const user = pb.authStore.isValid ? pb.authStore.record : null;

// Cargar cursos públicos
const records = await pb.collection('courses').getList(1, 3, { filter: 'status = "published"' });
const totalCourses = records.totalItems;
const courses = records.items.slice(0, 2);

// Si el usuario tiene sesión, cargamos su info de dashboard
let myCourses: any[] = [];
if (user) {
  const purchases = await pb.collection('purchases').getFullList({ filter: `user_id="${user.id}"`, expand: 'course_id' });
  const userProgress = await pb.collection('user_progress').getFullList({ filter: `user_id="${user.id}"` });

  myCourses = await Promise.all(purchases.map(async (purchase) => {
    const course = purchase.expand?.course_id;
    if (!course) return null;
    const sections = await pb.collection('course_sections').getFullList({ filter: `course_id="${course.id}"` });
    let totalLessons = 0;
    let completedLessonsInCourse = 0;
    let nextLessonUrl = `/courses/${course.slug}`;
    let firstLessonId = '';

    if (sections.length > 0) {
      for (const sec of sections) {
        const lessons = await pb.collection('lessons').getFullList({ filter: `section_id="${sec.id}"`, sort: 'order' });
        if (!firstLessonId && lessons.length > 0) firstLessonId = lessons[0].id;
        totalLessons += lessons.length;
        for (const l of lessons) {
          if (userProgress.some(p => p.lesson_id === l.id)) {
            completedLessonsInCourse++;
          } else if (nextLessonUrl === `/courses/${course.slug}`) {
            nextLessonUrl = `/learn/${course.slug}/${l.id}`;
          }
        }
      }
      if (completedLessonsInCourse === totalLessons && totalLessons > 0) {
        nextLessonUrl = `/learn/${course.slug}/${firstLessonId}`;
      }
    }

    const progressPercent = totalLessons === 0 ? 0 : Math.round((completedLessonsInCourse / totalLessons) * 100);

    const expiresAt = purchase.expires_at ? new Date(purchase.expires_at) : null;
    let daysLeft = null;
    if (expiresAt) {
      const diffTime = expiresAt.getTime() - new Date().getTime();
      daysLeft = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
      if (daysLeft < 0) daysLeft = 0;
    }

    return {
      ...course,
      progressPercent,
      nextLessonUrl,
      daysLeft
    };
  })).then(results => results.filter(c => c !== null));
}
---

<UserLayout title={user ? "Mi Dashboard" : "Cursos de Desarrollo y Diseño"} user={user}>
  {user ? (
    <main class="max-w-5xl mx-auto py-12 px-4 relative z-10 w-full">
      <div class="flex justify-between items-end mb-8">
        <div>
          <p class="text-stone-500 font-medium">¡Bienvenido de nuevo, {(user.name || user.username || 'Usuario').split(' ')[0]}! 👋</p>
          <h2 class="font-title text-4xl text-stone-800 uppercase mt-1">Tu Aprendizaje</h2>
        </div>
        <a href="/courses" class="text-rose-600 hover:text-rose-700 font-bold uppercase text-sm tracking-wide bg-rose-50 px-4 py-2 rounded-lg hidden sm:block">Explorar más</a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {myCourses.length === 0 ? (
          <div class="col-span-full text-center py-16 bg-white rounded-3xl border border-stone-200 border-dashed shadow-sm">
            <div class="text-5xl mb-4">🎓</div>
            <h3 class="font-title text-2xl text-rose-950 uppercase mb-2">Comienza tu aventura</h3>
            <p class="text-stone-500 mb-6 max-w-md mx-auto">Aún no tienes cursos activos. Explora nuestro catálogo y da el siguiente paso en tu carrera profesional.</p>
            <a href="/courses" class="bg-rose-500 hover:bg-rose-600 text-white font-bold py-3 px-6 rounded-xl transition-all shadow-md">Ver Catálogo de Cursos</a>
          </div>
        ) : (
          myCourses.map(course => (
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-stone-200 flex flex-col hover:border-rose-300 transition-colors">
              <h3 class="font-title text-xl text-rose-600 uppercase mb-2">{course.title}</h3>
              <p class="text-stone-500 text-sm mb-6 flex-1">{course.description.substring(0, 80)}...</p>
              
              <div class="mb-6">
                <div class="flex items-center gap-4 text-xs font-bold text-stone-500 mb-4 tracking-wide uppercase">
                  <div class="flex items-center gap-1" title="Duración del curso">
                    <span class="material-symbols-outlined text-[16px]">schedule</span>
                    {course.access_days > 0 ? `${course.access_days} Días` : 'De por vida'}
                  </div>
                  {course.daysLeft !== null && (
                    <div class={`flex items-center gap-1 ${course.daysLeft <= 5 ? 'text-red-500' : 'text-orange-500'}`} title="Días restantes de licencia">
                      <span class="material-symbols-outlined text-[16px]">timer</span>
                      {course.daysLeft} días restantes
                    </div>
                  )}
                </div>

                <div class="flex justify-between text-xs font-bold text-stone-500 mb-2 uppercase tracking-wide">
                  <span>Progreso</span>
                  <span>{course.progressPercent}%</span>
                </div>
                <div class="w-full bg-stone-100 rounded-full h-3">
                  <div class="bg-rose-500 h-3 rounded-full transition-all duration-1000" style={`width: ${course.progressPercent}%`}></div>
                </div>
              </div>

              <a href={course.nextLessonUrl} class="block w-full text-center bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold py-3 rounded-xl transition-all uppercase text-sm tracking-wide border border-rose-100">
                {course.progressPercent === 100 ? 'Repasar Curso' : (course.progressPercent === 0 ? 'Empezar Curso' : 'Continuar Curso')}
              </a>
            </div>
          ))
        )}
      </div>
    </main>
  ) : (
    <div class="flex flex-col items-center py-16 px-4">
      <div class="max-w-md w-full flex flex-col items-center gap-8">
        
        <!-- Profile Section -->
        <div class="flex flex-col items-center text-center gap-4">
          <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-rose-500 shadow-xl bg-stone-300">
            <img src="https://api.dicebear.com/9.x/avataaars/svg?seed=Joksan" alt="Joksan" class="w-full h-full object-cover" />
          </div>
          <div>
            <h1 class="font-title tracking-wide text-rose-950 text-4xl uppercase mt-2">Joksan</h1>
            <p class="text-stone-600 font-medium text-lg mt-1">Ingeniero de Software & Diseñador Web</p>
          </div>
        </div>

        <!-- Bio / Description -->
        <p class="text-center text-stone-700 leading-relaxed">
          Aprende a crear experiencias digitales increíbles. Desde el diseño visual hasta la lógica del código, te guío paso a paso.
        </p>

        <!-- Links / Products -->
        <div class="w-full flex flex-col gap-4">
          {courses.map(course => (
            <a href={`/courses/${course.slug}`} class="group relative block w-full bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border-2 border-transparent hover:border-rose-400 overflow-hidden text-center transform hover:-translate-y-1">
              <div class="absolute inset-0 bg-rose-50 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              <div class="relative z-10 flex flex-col items-center gap-2">
                <span class="text-3xl mb-1">🎓</span>
                <h2 class="font-title tracking-wide text-rose-950 text-2xl uppercase">{course.title}</h2>
                <p class="text-stone-500 text-sm">{course.description}</p>
                <span class="mt-2 inline-block bg-rose-100 text-rose-700 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider">Ver Curso</span>
              </div>
            </a>
          ))}

          {totalCourses > 2 && (
            <a href="/courses" class="text-center mt-2 text-stone-500 hover:text-rose-600 font-medium border border-stone-300 rounded-xl py-3 hover:border-rose-400 transition-colors">
              Ver todos los cursos →
            </a>
          )}
        </div>

        <!-- Login Link -->
        <div class="mt-8">
          <a href="/login" class="text-stone-400 hover:text-rose-500 transition-colors font-medium text-sm">
            ¿Ya tienes cuenta? Iniciar Sesión
          </a>
        </div>
      </div>
    </div>
  )}
</UserLayout>
