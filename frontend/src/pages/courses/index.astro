---
import '../../styles/global.css';
import { pb } from '../../lib/pocketbase';
import UserLayout from '../../layouts/UserLayout.astro';

pb.authStore.loadFromCookie(Astro.request.headers.get('cookie') || '');
const user = pb.authStore.isValid ? pb.authStore.record : null;

const records = await pb.collection('courses').getFullList({ filter: 'status = "published"' });
// Formatear los registros al mismo formato que usaba la UI
const courses = records.map(c => ({
  id: c.id,
  slug: c.slug,
  title: c.title,
  description: c.description,
  price: c.price
}));
---

<UserLayout title="Cursos" user={user}>
  <div class="flex flex-col items-center py-12 px-4 w-full">
    <div class="max-w-4xl w-full">
      <h1 class="font-title text-4xl text-rose-950 uppercase mb-8 mt-4">Nuestros Cursos</h1>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {courses.map(course => (
          <a href={`/courses/${course.slug}`} class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition-all border-2 border-transparent hover:border-rose-400">
            <div class="h-40 bg-stone-200 rounded-xl mb-4 flex items-center justify-center text-stone-400 text-5xl">🎓</div>
            <h2 class="font-title text-2xl text-rose-600 uppercase mb-2">{course.title}</h2>
            <p class="text-stone-600 text-sm mb-4">{course.description}</p>
            <div class="flex justify-between items-center">
              <span class="font-bold text-lg text-stone-900">${course.price}</span>
              <span class="bg-rose-100 text-rose-700 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wide">Ver Detalles</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</UserLayout>
