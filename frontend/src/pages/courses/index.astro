---
import '../../styles/global.css';

import { pb } from '../../lib/pocketbase';
const records = await pb.collection('courses').getFullList({ filter: 'status = "published"' });
// Formatear los registros al mismo formato que usaba la UI
const courses = records.map(c => ({
  id: c.id,
  slug: c.slug,
  title: c.title,
  description: c.description,
  price: c.price
}));
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Cursos | Joksan</title>
</head>
<body class="min-h-screen bg-stone-100 font-sans text-stone-900 antialiased flex flex-col items-center py-12 px-4">
  <div class="max-w-4xl w-full">
    <a href="/" class="text-stone-500 hover:text-rose-600 mb-8 inline-block font-medium">← Volver</a>
    <h1 class="font-title text-4xl text-rose-950 uppercase mb-8">Nuestros Cursos</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {courses.map(course => (
        <a href={`/courses/${course.slug}`} class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition-all border-2 border-transparent hover:border-rose-400">
          <div class="h-40 bg-stone-200 rounded-xl mb-4 flex items-center justify-center text-stone-400">Imagen del Curso</div>
          <h2 class="font-title text-2xl text-rose-600 uppercase mb-2">{course.title}</h2>
          <p class="text-stone-600 text-sm mb-4">{course.description}</p>
          <div class="flex justify-between items-center">
            <span class="font-bold text-lg text-stone-900">${course.price}</span>
            <span class="bg-rose-100 text-rose-700 px-4 py-1 rounded-full text-xs font-bold uppercase">Ver Detalles</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</body>
</html>
